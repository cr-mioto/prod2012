<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:cl="http://schemas.microsoft.com/sqlserver/reporting/2010/01/componentdefinition" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DsReport">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=SQLX\SQL2012;Initial Catalog=DBMain</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>ba26ace8-6a0e-4933-ae18-9c65af1e8ee7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Ds_Sintetico">
      <Query>
        <DataSourceName>DsReport</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MAQID">
            <Value>=Parameters!MAQID.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DT_Ini">
            <Value>=Parameters!DT_Ini.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DT_Fim">
            <Value>=Parameters!DT_Fim.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT   Producao.Servicos.DATA
 , Producao.Servicos.Maquina
 , SUM (Producao.Serv_Normais.QTDE) AS Quantidade
 , SUM (Producao.Serv_Normais.ACERTOS) AS Acertos
 , SUM (Producao.Serv_Normais.HORAS) AS Horas
 , SUM (Producao.Serv_Normais.FOLHAS) AS Folhas
 , SUM (Producao.Serv_Normais.M2) AS M2
 , SUM (Producao.Serv_Normais.Linear) AS Linear
 , SUM (Producao.Serv_Extra.HORAS) AS [Hora Extra]
 , SUM (Producao.Serv_Extra.ACERTOS) AS [Acerto Extra]
 , SUM (Producao.Serv_Extra.QTDE) AS [Qtde Extra]
FROM         
Producao.Servicos INNER JOIN
Producao.Serv_Normais ON Producao.Servicos.IDSERV = Producao.Serv_Normais.IDSERV INNER JOIN
Producao.Serv_Extra ON Producao.Servicos.IDSERV = Producao.Serv_Extra.IDSERV
WHERE	   
Producao.Servicos.MAQID=@MAQID
AND
Producao.Servicos.DATA         
BETWEEN 
@DT_Ini AND @DT_Fim
Group by DATA,MAQUINA</CommandText>
      </Query>
      <Fields>
        <Field Name="DATA">
          <DataField>DATA</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Folhas">
          <DataField>Folhas</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Maquina">
          <DataField>Maquina</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Quantidade">
          <DataField>Quantidade</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Acertos">
          <DataField>Acertos</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="M2">
          <DataField>M2</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Linear">
          <DataField>Linear</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Horas">
          <DataField>Horas</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Hora_Extra">
          <DataField>Hora Extra</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Acerto_Extra">
          <DataField>Acerto Extra</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Qtde_Extra">
          <DataField>Qtde Extra</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
