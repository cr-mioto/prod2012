  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DS2">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=SQLX\SQL2012;Initial Catalog=DBMain</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>2f9f0897-9dd4-4f9b-a3bc-28dea05cff4e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DSet1">
      <Query>
        <DataSourceName>DS2</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@VENDID">
            <Value>=Parameters!VENDID.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT      Producao.Embalagem_Foto.ID, Producao.Embalagem_Foto.FOTO
FROM         Producao.Embalagem INNER JOIN                     Producao.Embalagem_Foto ON Producao.Embalagem.ID = Producao.Embalagem_Foto.ID
WHERE Producao.Embalagem.COD_VENDEDOR=@VENDID
AND Producao.Embalagem.SITUACAO='ATIVO'</CommandText>
      </Query>
      <Fields>
        <Field Name="FOTO">
          <DataField>FOTO</DataField>
          <rd:TypeName>System.Byte[]</rd:TypeName>
        </Field>
        <Field Name="ID">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
